{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "prmptly",
  "version": "0.1.5",
  "identifier": "space.prmptly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "prmptly",
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwMjk4MDg1OTQyNUYzQzEKUldUQjh5V1VoWUFwb0RWRUJ2amNHMDNTREhtd2VWbXlYNVdQOThnK1Fadll4R0loYjBEcmZYYk0K",
      "endpoints": [
        "https://github.com/byhsr/prmptly/releases/latest/download/latest.json"
      ]
    }
  }
}